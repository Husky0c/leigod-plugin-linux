#!/bin/sh
set -eu

case "$1" in
    remove|purge|upgrade|deconfigure)
        if command -v systemctl >/dev/null 2>&1 \
            && systemctl cat leigod_plugin.service >/dev/null 2>&1; then
            systemctl stop leigod_plugin.service
        fi
        ;;
    *)
        echo "prerm called with unknown argument: $1" >&2
        exit 1
        ;;
esac

exit 0
